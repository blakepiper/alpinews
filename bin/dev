#!/bin/sh
set -eu
project=$(pwd -P)
base=$(basename "$project" | tr -cs 'a-zA-Z0-9_-' '_' | cut -c1-40)
hash=$(printf '%s' "$project" | sha256sum | cut -c1-12)
session="${base:-project}-$hash"
# The tmux server owns the name atomically. Parallel launches may attach to a
# just-created session rather than creating two copies.
if ! tmux has-session -t "=$session" 2>/dev/null; then
    left=$(tmux new-session -d -s "$session" -n dev -c "$project" -x 160 -y 48 -P -F '#{pane_id}' nvim .) || exit 1
    upper=$(tmux split-window -h -p 35 -t "$left" -c "$project" -P -F '#{pane_id}' /bin/ash -i)
    tmux split-window -v -p 50 -t "$upper" -c "$project" /bin/ash -c 'alpinews-stats; exec /bin/ash -i'
    tmux select-pane -t "$left"
fi
if [ -n "${TMUX:-}" ]; then exec tmux switch-client -t "=$session"; fi
exec tmux attach-session -t "=$session"
